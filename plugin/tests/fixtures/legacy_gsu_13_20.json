{
  "original_ipk_sha256": "81aea6eb25b5ed519e904af87a3d7bece5d32ae6886a1690dac8ab47306fe3f7",
  "control": "Package: enigma2-plugin-glasssysutil\nVersion: 13.20\nDescription: glasssysutil\nSection: base\nPriority: optional\nMaintainer: noone\nArchitecture: all\nOE: enigma2-plugin-glasssysutil\nHomepage: unknown\nDepends:\nSource: None\n",
  "postinst": "#!/bin/sh\nPLUGINPATH=/usr/lib/enigma2/python/Plugins/Extensions/GlassSysUtil\nif [ `ls -al /usr/lib/python2.7 2>/dev/null | grep base64.pyo | wc -l` -gt 0 ]; then\n echo \"*****************************\"\n echo \"OE 2.x.x - python 2.7  version activated!!!\"\n rm -rf $PLUGINPATH/plugin.pyo\n rm -rf $PLUGINPATH/plugin.pyc\n cp -f $PLUGINPATH/plugin.py32o $PLUGINPATH/plugin.pyo\nelif [ `ls -al /usr/lib/python3.8 2>/dev/null | grep base64.py | wc -l` -gt 0 ]; then\n echo \"*****************************\"\n echo \"OE 2.x.x - python 3.8 version activated!!!\"\n rm -rf $PLUGINPATH/plugin.pyo\n cp -f $PLUGINPATH/plugin.py38o $PLUGINPATH/plugin.pyc\nelif [ `ls -al /usr/lib/python3.9 2>/dev/null | grep base64.py | wc -l` -gt 0 ]; then\n cp -f $PLUGINPATH/plugin.py39o $PLUGINPATH/plugin.pyc\n echo \"*****************************\"\n echo \"python 3.9  version activated!!!\"\nelif [ `ls -al /usr/lib/python3.10 2>/dev/null | grep base64.py | wc -l` -gt 0 ]; then\n cp -f $PLUGINPATH/plugin.py310o $PLUGINPATH/plugin.pyc\n echo \"*****************************\"\n echo \"python 3.10  version activated!!!\"\nelif [ `ls -al /usr/lib/python3.11 2>/dev/null | grep base64.py | wc -l` -gt 0 ]; then\n cp -f $PLUGINPATH/plugin.py311o $PLUGINPATH/plugin.pyc\n echo \"*****************************\"\n echo \"python 3.11  version activated!!!\"\nelif [ `ls -al /usr/lib/python3.12 2>/dev/null | grep base64.py | wc -l` -gt 0 ]; then\n cp -f $PLUGINPATH/plugin.py312o $PLUGINPATH/plugin.pyc\n echo \"*****************************\"\n echo \"python 3.12  version activated!!!\"\nelif [ `ls -al /usr/lib/python3.13 2>/dev/null | grep base64.py | wc -l` -gt 0 ]; then\n cp -f $PLUGINPATH/plugin.py313o $PLUGINPATH/plugin.pyc\n echo \"*****************************\"\n echo \"python 3.13  version activated!!!\"\nelse\n echo \"*****************************\"\n if [ `ls -al /usr/lib/python2.6 | grep ftplib.py | wc -l` -gt 0 ]; then\n  echo \"****************************\"\n else\n  cp -f /usr/bin/ftplib.py /usr/lib/python2.6/ftplib.py\n fi\n if [ `ls -al /usr/lib/enigma2/python | grep enigma.pyo | wc -l` -gt 0 ]; then\n  echo \"OE 1.6 version activated!!!\"\n rm -rf $PLUGINPATH/plugin.pyc\n else\n  echo \"Old OE 1.6 version activated!!!\"\n rm -rf $PLUGINPATH/plugin.pyo\n fi\nfi\necho \"**********************************************************\"\nif [ `ls -al /etc | grep nfs_cifs.cfg | wc -l` -gt 0 ]; then\n echo \"nfs_cifs.cfg exists, there is no need to copy nfs_cifs.cfg\"\nelse\n cp /etc/nfs_cifs-def.cfg /etc/nfs_cifs.cfg\nfi\necho \"*******************************************************************************\"\nif [ `ls -al /etc | grep piconPaths.conf | wc -l` -gt 0 ]; then\n echo \"piconPaths.conf exists, there is no need to copy piconPaths.conf\"\nelse\n cp /etc/piconPaths-def.conf /etc/piconPaths.conf\nfi\nif [ `ls -al /usr/share/misc | grep hddtemp.db | wc -l` -gt 0 ]; then\n echo \"*******************************************************************************\"\nelse\n cp /usr/share/misc/hddtemp-def.db /usr/share/misc/hddtemp.db\nfi\nif [ `ls -al /etc | grep hddtemp.db | wc -l` -gt 0 ]; then\n echo \"*******************************************************************************\"\nelse\n cp /etc/hddtemp-def.db /etc/hddtemp.db\nfi\necho \"*******************************************************************************\"\nif [ `ls -al /etc | grep remote_servers.cfg | wc -l` -gt 0 ]; then\n echo \"remote_servers-def.cfg exists, there is no need to copy remote_servers-def.cfg\"\nelse\n cp /etc/remote_servers-def.cfg /etc/remote_servers.cfg\nfi\nrm -rf /usr/share/misc/hddtemp-def.db\nrm -rf /etc/nfs_cifs-def.cfg\nrm -rf /etc/piconPaths-def.conf\nrm -rf /etc/remote_servers-def.cfg\nrm -rf /usr/bin/ftplib.py\nrm -rf $PLUGINPATH/plugin.py32o\nrm -rf $PLUGINPATH/plugin.py38o\nrm -rf $PLUGINPATH/plugin.py39o\nrm -rf $PLUGINPATH/plugin.py310o\nrm -rf $PLUGINPATH/plugin.py311o\nrm -rf $PLUGINPATH/plugin.py312o\necho \"*****************************************************\"\necho \"GUI restart is required to enable the plugin, enjoy !\"\nexit 0\n",
