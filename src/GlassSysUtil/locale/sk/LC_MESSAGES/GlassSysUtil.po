msgstr "Reštart CAM zlyhal.\\n\\n%s"

msgid "Active CAM restart verified%s."
msgstr "Reštart CAM bol overený%s."

msgid "Restart command completed, but no active CAM was detected afterwards."
msgstr "Príkaz na reštart skončil, ale potom nebol zistený žiadny aktívny CAM."

msgid "Unable to start CAM restart worker."
msgstr "Nepodarilo sa spustiť proces reštartu CAM."

