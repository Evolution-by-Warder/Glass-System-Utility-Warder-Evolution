msgstr "Aktualizácie sa nepodarilo skontrolovať.\\n\\n%s"

msgid "Update installation is unavailable on this Enigma2 image."
msgstr "Inštalácia aktualizácie nie je na tomto Enigma2 image dostupná."

msgid "Update installation failed.\\n\\n%s"
msgstr "Inštalácia aktualizácie zlyhala.\\n\\n%s"

