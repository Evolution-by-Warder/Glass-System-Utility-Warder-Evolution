msgid "GSU Service Dashboard"
msgstr "GSU Prehľad služieb"

msgid "Dashboard is read-only. Use dedicated screens for full diagnostics."
msgstr "Prehľad je iba na čítanie. Na úplnú diagnostiku použite príslušné obrazovky."

msgid "GSU Network Health"
msgstr "GSU Stav siete"

msgid "Network Health is read-only; ping failure alone is reported as a warning, not proof of link failure."
msgstr "Stav siete je iba na čítanie; neúspešný ping je len upozornenie, nie dôkaz výpadku spojenia."

msgid "GSU Network Mount Doctor"
msgstr "GSU Diagnostika sieťových pripojení"

msgid "GSU Enigma2 Runtime Health"
msgstr "GSU Stav Enigma2"

msgid "Runtime Health is read-only; it does not restart Enigma2 or delete logs."
msgstr "Stav Enigma2 je iba na čítanie; nereštartuje Enigma2 ani nemaže logy."

msgid "GSU Storage Health"
msgstr "GSU Stav úložísk"

msgid "Storage Health is read-only and does not run destructive filesystem tests."
msgstr "Stav úložísk je iba na čítanie a nespúšťa deštruktívne testy súborových systémov."

